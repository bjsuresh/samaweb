# Angular SPA routing: serve index.html for any path that is not a real file
# or directory, so deep links like /about-us work on refresh / direct hit.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Leave the PHP API alone
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # Existing files and directories are served as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ /index.html [L]
</IfModule>
